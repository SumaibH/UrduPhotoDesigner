<?xml version="1.0" encoding="utf-8"?>
<!--
    The white pill that captions a dimmed panel ("Select a text layer").

    Fully rounded like bg_search_pill, near-white like bg_preview_eye's disc —
    the hairline is a light-on-dark one here because the pill only ever sits on
    the inactive scrim, and a surface_stroke hairline would vanish into it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <solid android:color="@color/panel_state_chip_bg" />

    <stroke
        android:width="1dp"
        android:color="@color/panel_state_chip_stroke" />

    <corners android:radius="100dp" />
</shape>
