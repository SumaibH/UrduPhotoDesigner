<?xml version="1.0" encoding="utf-8"?>
<!-- Top fade so the grid dissolves into the screen instead of cutting under
     the search field. Follows the page colour, not the item colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:endColor="@color/screen_bg_transparent"
        android:startColor="@color/screen_bg"
        android:type="linear" />
</shape>
