<?xml version="1.0" encoding="utf-8"?>
<!--
    The asset preview's loading placeholder. Deliberately a shade darker than the
    paper it covers: a white block shimmering on a white page is indistinguishable
    from a page that has simply come up empty.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_stroke" />
    <corners android:radius="8dp" />
</shape>
