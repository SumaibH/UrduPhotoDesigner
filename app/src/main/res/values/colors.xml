    <!-- Screen UI theme.
         One hierarchy for every non-editor screen:
           screen_bg   the page itself (white)
           surface_1   anything sitting ON the page (cards, tiles, search
                       fields, chips, icon buttons) — the contrast fill
           surface_2   anything sitting INSIDE one of those surfaces (the
                       artboard inside a size tile, a font preview)
         The editor keeps its own palette and is deliberately exempt. -->
    <color name="screen_bg">#FFFFFF</color>
    <!-- The header glyph laid into a page as a watermark: brand green on a light
         page, plain white on a dark one. Always paired with a low view alpha. -->
    <color name="watermark_tint">#005D28</color>
    <color name="surface_1">#F7F7F7</color>
    <color name="surface_2">#FFFFFF</color>
    <color name="surface_stroke">#ECECEC</color>
    <!-- Hairline separators inside a list. Lighter than surface_stroke so a long
         run of rows reads as one surface rather than a stack of boxes. -->
    <color name="surface_stroke_subtle">#F1F1F1</color>
    <!-- Frame + icon inside a size tile: soft enough to read as an outline. -->
    <color name="tile_frame">#C3C9D2</color>
    <color name="screen_bg_transparent">#00FFFFFF</color>
    <!-- Splash: the loading line's track and the publisher line, white at low alpha on the green. -->
    <color name="splash_loader_track">#2EFFFFFF</color>
    <color name="splash_publisher_text">#8CFFFFFF</color>

    <!-- ═══ Inactive-panel state ═══
         A panel whose content needs a selection it does not have gets dimmed
         behind this scrim and captions itself with a chip on top. The scrim is
         deliberately short of opaque: the grid has to stay legible as *that*
         grid, so the state reads as "not yet" rather than "empty".
         The chip stays literally white in both themes — @color/white is the
         themed surface and inverts to near-black at night, which would sink the
         chip into its own scrim. -->
    <color name="panel_inactive_scrim">#8A000000</color>
    <color name="panel_state_chip_bg">#F2FFFFFF</color>
    <color name="panel_state_chip_stroke">#33FFFFFF</color>
    <color name="panel_state_chip_text">#2B2B2B</color>
