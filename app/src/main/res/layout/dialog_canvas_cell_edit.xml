<?xml version="1.0" encoding="utf-8"?>
<!--
  Table cell entry dialog.

  A floating card, inset on every side and rounded all round, rather than a panel
  welded to the bottom edge. It still sits low so the table it is editing stays in
  view above it.

  Typing a table is a loop: read where you are, type, move on. The layout is built
  around those three beats — a context block that names the cell in the user's own
  words, one input, and a pager whose two halves always move the selection the way
  they point. Direction is bound at runtime: in an RTL table column N+1 is drawn to
  the LEFT, so the left half becomes "Next" and the right half "Previous".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="16dp"
    tools:ignore="HardcodedText">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cell_edit_dialog"
    android:elevation="20dp"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Context: which cell this is, said the way the user thinks about it -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCellPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/regular"
                android:letterSpacing="0.04"
                android:text="Row 1"
                android:textAllCaps="true"
                android:textColor="@color/gray"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvHeaderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:text="Column 1"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_bg_small"
            android:fontFamily="@font/bold"
            android:paddingHorizontal="22dp"
            android:paddingVertical="10dp"
            android:text="Done"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Input. Clear sits on the start edge: the text is right-aligned for Urdu,
         so the left of the field is the empty side. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/editCellInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cell_edit_field"
            android:fontFamily="@font/regular"
            android:gravity="center_vertical|end"
            android:hint="متن درج کریں"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="54dp"
            android:paddingStart="48dp"
            android:paddingEnd="16dp"
            android:paddingVertical="10dp"
            android:scrollbars="vertical"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:textCursorDrawable="@null"
            android:textSize="17sp"
            tools:text="متن شنواری باف" />

        <ImageView
            android:id="@+id/btnClearCell"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="7dp"
            android:contentDescription="Clear cell"
            android:padding="13dp"
            android:src="@drawable/ic_close"
            app:tint="@color/gray" />
    </FrameLayout>

    <!-- Pager. Each half moves the selection in the direction it points. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnStepStart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_cell_nav_button"
            android:drawablePadding="9dp"
            android:fontFamily="@font/medium"
            android:gravity="center"
            android:text="Previous"
            android:textColor="@color/black"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_back"
            app:drawableTint="@color/black" />

        <TextView
            android:id="@+id/tvCellCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:fontFamily="@font/medium"
            android:minWidth="56dp"
            android:gravity="center"
            android:text="1 of 9"
            android:textColor="@color/gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnStepEnd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_cell_nav_button"
            android:drawablePadding="9dp"
            android:fontFamily="@font/medium"
            android:gravity="center"
            android:text="Next"
            android:textColor="@color/black"
            android:textSize="13sp"
            app:drawableEndCompat="@drawable/ic_chevron_forward"
            app:drawableTint="@color/black" />
    </LinearLayout>

</LinearLayout>

</FrameLayout>
