<?xml version="1.0" encoding="utf-8"?>
<!--
    The asset preview's content, filling a bottom sheet of the same shape the
    Create Canvas sheet uses: full width, full height, opened part-way up and
    dragged the rest of the way.

    Height is match_parent, not wrap_content, because the sheet frame around it is
    full height: the column has to reach the bottom of whatever the drag exposes,
    and [previewWell] is the part that grows to take it. The sheet pads the bottom
    of this view down to the visible edge as it slides — see AssetPreviewSheet.

    Dismiss is the plain cross at the end of the header, the same control the
    Create, Export, Premium-assets, Imported-fonts and Filter sheets all use. The
    breadcrumb stays as a label because it names the set the asset came from,
    which nothing else on the sheet says.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- ── Header ─────────────────────────────────────────────────────────── -->

    <LinearLayout
        android:id="@+id/previewHeader"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/breadcrumbLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/appColor"
            android:textSize="12sp"
            tools:text="Fonts" />

        <TextView
            android:id="@+id/breadcrumbDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:fontFamily="@font/bold"
            android:includeFontPadding="false"
            android:text="@string/preview_breadcrumb_separator"
            android:textColor="@color/gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/previewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/bold"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textSize="14sp"
            tools:text="Jameel Noori Nastaleeq" />

        <TextView
            android:id="@+id/proPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/ic_button_gradient_wrap"
            android:fontFamily="@font/bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="@string/pro"
            android:textColor="@color/whiteText"
            android:textSize="8.5sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!--
            The app's close affordance, unchanged from the other sheets: a 32dp
            round button at the trailing end of the header.
        -->
        <ImageView
            android:id="@+id/previewClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/surface_1"
            android:clickable="true"
            android:contentDescription="@string/close_menu"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/black" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tab_divider" />

    <!-- ── Body ───────────────────────────────────────────────────────────── -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <!--
            Well + paper: the asset shown the way it sits on the canvas.

            The well takes every pixel the pills, the sample field and the buttons
            below it do not, so dragging the sheet up makes the artwork bigger
            rather than opening a gap under the buttons. That is a weight in a
            fixed-height column, never wrap_content: the shimmer covering the well
            while an asset loads is match_parent, and in a wrap_content parent that
            measures to everything going spare — which is how the well once grew to
            the whole screen and pushed the buttons off the bottom of the sheet.

            How tall the well starts out is now the sheet's halfExpandedRatio, not a
            height set here — see AssetPreviewSheet.
        -->
        <FrameLayout
            android:id="@+id/previewWell"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_preview_well"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/previewPaper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_preview_paper"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <!--
                    Everything the paper shows, in one layer so a pinch can scale the
                    lot together — the specimen with its alphabet rows, or the image.
                    The paper stays put and clips, so a zoomed asset is cropped by the
                    page rather than spilling over the well.
                -->
                <LinearLayout
                    android:id="@+id/zoomLayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                <TextView
                    android:id="@+id/fontSample"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/black"
                    android:textDirection="rtl"
                    android:textSize="32sp"
                    android:visibility="gone"
                    tools:text="اردو کینوس"
                    tools:visibility="visible" />

                <View
                    android:id="@+id/sampleDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/tab_divider"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/alphabetRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/gray"
                    android:textDirection="rtl"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:text="ا ب پ ت ٹ ث ج چ ح خ" />

                <TextView
                    android:id="@+id/numeralRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/gray"
                    android:textDirection="rtl"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:text="۰ ۱ ۲ ۳ ۴ ۵ ۶ ۷ ۸ ۹" />

                <!--
                    Fills the page: the artwork is the reason the preview was opened, and
                    a fixed box left it small in the middle of a mostly empty sheet.
                -->
                <ImageView
                    android:id="@+id/assetImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/preview"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <!--
                Covers the paper until the asset has actually arrived. Assets here come
                off the network or out of a renderer, so without this the page sits
                blank and reads as broken rather than as loading.
            -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/assetShimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_preview_shimmer_block" />

            </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>

        <!-- Details. ChipGroup is used for its flow layout, not its chips. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp"
            app:singleLine="false" />

        <!-- Fonts only: try the face on your own words -->
        <EditText
            android:id="@+id/sampleInput"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search_pill"
            android:fontFamily="@font/regular"
            android:hint="@string/preview_type_your_words"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:textDirection="rtl"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/primaryAction"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ic_button_gradient_wrap"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:textColor="@color/whiteText"
                android:textSize="14sp"
                tools:text="Use on canvas" />

            <ImageView
                android:id="@+id/shareAction"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_preview_action_round"
                android:contentDescription="@string/share"
                android:padding="12dp"
                android:src="@drawable/ic_share"
                app:tint="@color/black" />

            <FrameLayout
                android:id="@+id/downloadAction"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_preview_action_round">

                <ImageView
                    android:id="@+id/downloadIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/download"
                    android:padding="12dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/black" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/downloadSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:visibility="gone"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/loading_gray" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
