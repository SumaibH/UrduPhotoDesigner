<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/textSymbolsFragmentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.editor.panels.text.symbols.TextSymbolsFragment">

    <!-- Left Collapsible Category Rail -->
    <com.webscare.urducanvas.ui.editor.views.CollapsibleRailView
        android:id="@+id/collapsibleRail"
        android:layout_width="118dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Right Side Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightContentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/collapsibleRail"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Character Selection & Action Strip -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/charActionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/contrast"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Live Letter Badge -->
            <LinearLayout
                android:id="@+id/badgePreviewContainer"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="#DCFCE7"
                android:gravity="center"
                android:minWidth="34dp"
                android:paddingHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvPreviewChar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bold"
                    android:includeFontPadding="false"
                    android:textColor="#15803D"
                    android:textSize="18sp"
                    tools:text="کَ" />
            </LinearLayout>

            <!-- Quick Action: Dotless Toggle (بے نقط) -->
            <TextView
                android:id="@+id/btnToggleDotless"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/medium"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="بے نقط"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/badgePreviewContainer"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Quick Action: Delete Last Diacritic (⌫) -->
            <TextView
                android:id="@+id/btnDeleteLastDiacritic"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/bold"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:text="⌫"
                android:textColor="@color/black"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnToggleDotless"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Quick Action: Clear All Diacritics (صاف) -->
            <TextView
                android:id="@+id/btnClearAllDiacritics"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/medium"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="صاف"
                android:textColor="@color/gray"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnDeleteLastDiacritic"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Calligraphy Breakdown Button (خطاطی) -->
            <TextView
                android:id="@+id/btnCalligraphyBreakdown"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="#FEF3C7"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/bold"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="✨ خطاطی"
                android:textColor="#B45309"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Horizontal Character Chips Strip -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCharacters"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/charActionHeader" />

        <View
            android:id="@+id/stripDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/tab_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvCharacters" />

        <!-- Symbols ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:saveEnabled="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/stripDivider" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
