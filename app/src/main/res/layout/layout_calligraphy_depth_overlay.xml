<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calligraphyOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_bg"
    android:elevation="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <!-- Top Row: Mode Title & Floating Actions -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overlayHeader"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvModeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"
            android:text="✨ خطاطی موڈ (Calligraphy Depth)"
            android:textColor="@color/black"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Kashida Button -->
            <TextView
                android:id="@+id/btnOverlayKashida"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/medium"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="+ کشیدہ"
                android:textColor="@color/black"
                android:textSize="11sp" />

            <!-- Dotless Skeleton Button -->
            <TextView
                android:id="@+id/btnOverlayDotless"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/medium"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="بے نقط"
                android:textColor="@color/black"
                android:textSize="11sp" />

            <!-- Rejoin / Collapse Button -->
            <TextView
                android:id="@+id/btnOverlayCollapse"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="@color/contrast"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/medium"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="جوڑیں"
                android:textColor="#B91C1C"
                android:textSize="11sp" />

            <!-- Done Button (Finish Calligraphy) -->
            <TextView
                android:id="@+id/btnOverlayDone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/button_bg_small"
                android:backgroundTint="#15803D"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/bold"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="مکمل ✓"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Row: Horizontal Tokens Selection Strip -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOverlayTokens"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:paddingHorizontal="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/overlayHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
