<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/presetItemContainer"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/contrast"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/appColor"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/presetPreviewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/contrast"
            android:contentDescription="Style Preset Preview"
            android:padding="4dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/presetTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/medium"
            android:gravity="center"
            android:text="+ Save"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:visibility="gone" />

        <!--
            Same badge the font and image grids use. A lockup inherits premium from the
            fonts and styles it is built from, so the badge is computed rather than
            stored — and like everywhere else in the editor it marks the asset without
            blocking it, because the subscription gate is at export.
        -->
        <ImageView
            android:id="@+id/isPremium"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:contentDescription="@string/premium"
            android:src="@drawable/ic_premium_icon"
            android:visibility="gone" />

        <!--
            Opens the preview while the panel is expanded. Collapsed, the tile is
            44dp and this would cover it, so long-press does the same job there.
        -->
        <ImageView
            android:id="@+id/previewEye"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:alpha="0.75"
            android:background="@drawable/bg_preview_eye"
            android:clickable="true"
            android:contentDescription="@string/preview"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_eye"
            android:visibility="gone" />
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
