<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/drag_handle_bg" />

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/bold"
        android:text="خطاطی موڈ (Calligraphy Composition)"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvDialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/regular"
        android:text="متن کے الفاظ یا حروف الگ کر کے کینوس پر آزادانہ ترتیب دیں"
        android:textColor="@color/gray"
        android:textSize="12sp" />

    <!-- Option 1: Break into Words -->
    <LinearLayout
        android:id="@+id/btnBreakWords"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_bg_small"
        android:backgroundTint="@color/contrast"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="#DCFCE7"
            android:fontFamily="@font/bold"
            android:gravity="center"
            android:text="لفظ"
            android:textColor="#15803D"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:text="الفاظ الگ کریں (Words Breakdown)"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/regular"
                android:text="ہر لفظ کو الگ گھمائیں، بڑا کریں اور اوپر نیچے رکھیں"
                android:textColor="@color/gray"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 2: Break into Characters -->
    <LinearLayout
        android:id="@+id/btnBreakCharacters"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_bg_small"
        android:backgroundTint="@color/contrast"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="#FEF3C7"
            android:fontFamily="@font/bold"
            android:gravity="center"
            android:text="حرف"
            android:textColor="#B45309"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:text="حروف الگ کریں (Characters Breakdown)"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/regular"
                android:text="حروف کو روایتی خطاطی کی طرح جوڑیں اور کشیدہ بنائیں"
                android:textColor="@color/gray"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 3: Rejoin to Normal Text (Only visible if already expanded) -->
    <LinearLayout
        android:id="@+id/btnCollapseText"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/button_bg_small"
        android:backgroundTint="@color/contrast"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="#FEE2E2"
            android:fontFamily="@font/bold"
            android:gravity="center"
            android:text="جوڑیں"
            android:textColor="#B91C1C"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:text="دوبارہ جوڑیں (Rejoin to Single Text)"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/regular"
                android:text="تمام حصوں کو دوبارہ عام متن میں تبدیل کریں"
                android:textColor="@color/gray"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
