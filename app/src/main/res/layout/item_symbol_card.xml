<?xml version="1.0" encoding="utf-8"?>
<!--
    One symbol tile, built like layout_filter_item.xml: a square MaterialCardView
    whose stroke carries the state. No caption — the glyph is sized up instead,
    and the name is available on long press (same as the rail categories).
    No foreground ripple: presses come from Utils.addPressEffect.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/symbolCardRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="3dp"
    android:layout_marginVertical="3dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/symbolCard"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardBackgroundColor="@color/contrast"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/appColor"
        app:strokeWidth="0dp">

        <!--
            Auto-sized rather than a flat 28sp: the honorific ligatures (ﷺ, ﷻ,
            and Bismillah above all) are many times wider than a diacritic and
            were being clipped by the square tile.
        -->
        <TextView
            android:id="@+id/tvSymbolGlyph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingHorizontal="3dp"
            android:textColor="@color/black"
            app:autoSizeMaxTextSize="28sp"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="ـَ" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
