<?xml version="1.0" encoding="utf-8"?>
<!--
    One character/word tile in the selection strip. Square like the filter items,
    with the stroke carrying the selected state instead of a solid fill, so the
    glyph stays readable in its own colour. No foreground ripple — presses come
    from Utils.addPressEffect.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/charChipRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="3dp">

    <!-- Circular: corner radius is half the 36dp box. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/charCard"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:cardBackgroundColor="@color/contrast"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/appColor"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/tvChar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/black"
            android:textSize="17sp"
            tools:text="ک" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
