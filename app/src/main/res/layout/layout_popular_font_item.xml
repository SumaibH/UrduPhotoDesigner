<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fontCard"
    android:layout_width="70dp"
    android:layout_height="70dp"
    android:layout_marginHorizontal="6dp"
    app:cardBackgroundColor="@color/surface_1"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/surface_stroke"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.5"
            app:shimmer_duration="700"
app:shimmer_repeat_delay="0"
            app:shimmer_base_color="@color/surface_1"
            app:shimmer_colored="true"
            app:shimmer_highlight_alpha="@dimen/shimmer_highlight_alpha">

            <!--
              fitCenter, not centerCrop. Font previews are wide glyph images of varying
              aspect ratio; centerCrop scales them until they fill the card and throws
              away whatever hangs over, which sliced the sides off every preview wider
              than the tile. The editor's own font list has always used fitCenter — this
              is the one place that did not.
            -->
            <ImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:background="@color/surface_2"
                android:padding="8dp"
                android:scaleType="fitCenter" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/loading"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:lottie_rawRes="@raw/loading_gray"
            app:lottie_autoPlay="true"
            android:layout_gravity="end|bottom"
            android:layout_margin="4dp"
            android:visibility="gone"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/surface_2"
            app:lottie_loop="true"
            android:padding="4dp"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_premium_icon"
            android:layout_gravity="top|end"
            android:id="@+id/isPremium"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/download"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|bottom"
            android:layout_margin="4dp"
            android:src="@drawable/ic_download"
            android:visibility="gone"
            android:background="@drawable/button_bg_round"
            android:backgroundTint="@color/surface_1"
            android:padding="6dp"
            app:tint="@color/download_tint" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>