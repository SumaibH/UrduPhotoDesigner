<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    tools:context=".ui.navigation.home.HomeFragment">

    <!-- ─────────────────────────────────────────────────────────────
         HEADER — one surface that morphs as the feed scrolls, driven
         frame by frame from the scroll offset (no state flip, no
         threshold). `title` sits outside `expandedContent` because it
         is the shared element: it scales from display size down to
         toolbar size rather than cross-fading into a second copy of
         itself. Everything beneath it fades and slides away.

         Draws full-bleed behind the status bar; `statusSpacer` is
         sized at runtime from the status bar inset.
         ───────────────────────────────────────────────────────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:translationZ="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Expanded artwork. Fades out on collapse, leaving the flat
             gradient bg_home_header already paints underneath. -->
        <ImageView
            android:id="@+id/headerArt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_home_header_art"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
            Calligraphy watermark occupying the right of the header, where the
            gold sweep used to be. The asset is white on transparency, so the
            green ground reads through it; alpha keeps it a whisper rather than
            a graphic competing with the title. Fades out with the rest of the
            artwork on collapse.
        -->
        <!--
            Watermark bleeding out of the top-right corner.

            It is sized to the header (0dp, pinned top and bottom) and enlarged
            with scaleX/scaleY rather than a big layout_height. The header is
            wrap_content, so a tall child would stretch it — a 470dp image added
            170dp of empty green below the content. Scale is a draw-time
            transform, so it makes the glyph big without touching measurement,
            and the header clips whatever spills past its edges.
        -->
        <ImageView
            android:id="@+id/headerCalligraphy"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.10"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:scaleX="1.75"
            android:scaleY="1.75"
            android:src="@drawable/header_calligraphy"
            android:translationX="52dp"
            android:translationY="-40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.44" />

        <!-- Status bar inset spacer (height set in HomeFragment) -->
        <View
            android:id="@+id/statusSpacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ── The morphing element ──────────────────────────────── -->
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/bold"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/whiteText"
            android:textSize="27sp"
            app:layout_constraintEnd_toStartOf="@id/headerActions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusSpacer" />

        <!-- Expanded action set: files + settings -->
        <LinearLayout
            android:id="@+id/headerActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/title">

            <ImageView
                android:id="@+id/filesBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_header_icon_circle"
                android:contentDescription="@string/filesTab"
                android:padding="10dp"
                android:src="@drawable/ic_files"
                app:tint="@color/whiteText" />

            <ImageView
                android:id="@+id/settingsBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_header_icon_circle"
                android:contentDescription="@string/settings"
                android:padding="10dp"
                android:src="@drawable/ic_setting"
                app:tint="@color/whiteText" />
        </LinearLayout>

        <!-- Collapsed action set: the shortcuts the expanded cards carry -->
        <LinearLayout
            android:id="@+id/collapsedActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:alpha="0"
            android:orientation="horizontal"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/title">

            <ImageView
                android:id="@+id/collapsedNewCanvas"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_header_icon_circle"
                android:contentDescription="@string/blank_canvas"
                android:padding="9dp"
                android:src="@drawable/ic_blank_canvas"
                app:tint="@color/whiteText" />

            <ImageView
                android:id="@+id/collapsedAddPhoto"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_header_icon_circle"
                android:contentDescription="@string/upload_photo"
                android:padding="9dp"
                android:src="@drawable/ic_create"
                app:tint="@color/whiteText" />

            <ImageView
                android:id="@+id/collapsedSearch"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_header_icon_circle"
                android:contentDescription="@string/search_templates"
                android:padding="10dp"
                android:src="@drawable/ic_search"
                app:tint="@color/whiteText" />
        </LinearLayout>

        <!-- ── Everything that only exists while expanded ─────────── -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/expandedContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title">

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:fontFamily="@font/regular"
                android:maxLines="1"
                android:text="@string/home_tagline"
                android:textColor="@color/home_header_subtitle"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/searchBar"
                style="@style/Widget.UrduCanvas.SearchBar"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:hint="@string/search_templates_fonts_and_assets"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subtitle" />

            <!-- Add Photo -->
            <LinearLayout
                android:id="@+id/create"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_home_action_card"
                android:foreground="?selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="13dp"
                android:paddingVertical="14dp"
                app:layout_constraintBottom_toBottomOf="@id/blankCanvas"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/blankCanvas"
                app:layout_constraintTop_toTopOf="@id/blankCanvas">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@null"
                    android:padding="5dp"
                    android:src="@drawable/ic_create"
                    app:tint="@color/home_action_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/bold"
                        android:maxLines="1"
                        android:text="@string/upload_photo"
                        android:textColor="@color/black"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/regular"
                        android:maxLines="1"
                        android:text="@string/start_with_an_image"
                        android:textColor="@color/gray"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- New Canvas -->
            <LinearLayout
                android:id="@+id/blankCanvas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_home_action_card"
                android:foreground="?selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="13dp"
                android:paddingVertical="14dp"
                app:layout_constraintEnd_toStartOf="@id/create"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/searchBar"
                app:layout_constraintWidth_percent="0.44">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="@null"
                    android:padding="5dp"
                    android:src="@drawable/ic_blank_canvas"
                    app:tint="@color/home_action_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/bold"
                        android:maxLines="1"
                        android:text="@string/blank_canvas"
                        android:textColor="@color/black"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/regular"
                        android:maxLines="1"
                        android:text="@string/create_blank_artboard"
                        android:textColor="@color/gray"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Points at the Files tab for imports; sits under the two CTAs. -->
            <LinearLayout
                android:id="@+id/filesHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/blankCanvas">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/regular"
                    android:text="@string/manage_custom_fonts_assets_and_imports_in_files_tab"
                    android:textColor="@color/whiteText"
                    android:textSize="12sp" />

                <!-- Underlined + clickable: jumps straight to the Files tab. -->
                <TextView
                    android:id="@+id/fileTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/bold"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp"
                    android:text="@string/filesTab"
                    android:textColor="@color/whiteText"
                    android:textSize="12sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ─────────────────────────────────────────────────────────────
         FEED — recents › popular templates › fonts › sizes › templates.
         Every section is header + list on the same rhythm: the section
         header owns the top gap, the list owns 12dp of side padding.

         Anchored to the parent, NOT to the header: its top padding is set
         once from the expanded header height so the feed scrolls under the
         header without being re-measured on every collapse frame.
         ───────────────────────────────────────────────────────────── -->
    <com.webscare.urducanvas.common.views.SpringNestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="110dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <!-- Recent projects -->
            <include
                android:id="@+id/recentProjects"
                layout="@layout/layout_home_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentsRV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/layout_recents_item" />

            <!-- Popular templates -->
            <include
                android:id="@+id/popularTemplate"
                layout="@layout/layout_home_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/popularTemplateRV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/layout_template_popular" />

            <com.webscare.ads.WebsCareNativeView
                android:id="@+id/home_native_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="19dp"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:webscare_native_size="small"
                app:webscare_show_shimmer="true" />

            <!-- Popular fonts -->
            <include
                android:id="@+id/popularFonts"
                layout="@layout/layout_home_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fontsRV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/layout_popular_font_item" />

            <!-- Browse by size -->
            <include
                android:id="@+id/sizesSection"
                layout="@layout/layout_home_section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sizesRV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/layout_sizes_filter_item" />

            <!-- All templates, by category — rows carry their own titles -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoriesRV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="20dp"
                app:layoutManager="com.webscare.urducanvas.common.views.SafeLinearLayoutManager"
                tools:listitem="@layout/layout_category_row" />
        </LinearLayout>
    </com.webscare.urducanvas.common.views.SpringNestedScrollView>

    <!-- Loading skeleton (shown during initial fetch) -->
    <include
        android:id="@+id/loadingState"
        layout="@layout/layout_home_skeleton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <!-- Error / empty state -->
    <include
        android:id="@+id/errorState"
        layout="@layout/layout_home_error"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />
</androidx.constraintlayout.widget.ConstraintLayout>
